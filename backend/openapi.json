{
  "openapi": "3.1.1",
  "info": {
    "title": "Musialize.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/branding": {
      "get": {
        "tags": [
          "Branding"
        ],
        "operationId": "GetBranding",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrandingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/songs": {
      "get": {
        "tags": [
          "Songs"
        ],
        "operationId": "GetSuggestions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SongResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BrandingResponse": {
        "required": [
          "appName",
          "shortName"
        ],
        "type": "object",
        "properties": {
          "appName": {
            "type": "string"
          },
          "shortName": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status",
          "version",
          "databaseMigration"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "version": {
            "type": "string"
          },
          "databaseMigration": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "HealthStatus": {
        "enum": [
          "healthy",
          "unhealthy"
        ]
      },
      "SongResponse": {
        "required": [
          "id",
          "title",
          "artist",
          "link",
          "suggestedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "suggestedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Branding"
    },
    {
      "name": "Songs"
    }
  ]
}