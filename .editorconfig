root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

# Enforced in the build (EnforceCodeStyleInBuild, warnings as errors).
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0005.severity = warning # unnecessary using
dotnet_diagnostic.IDE0055.severity = warning # formatting
dotnet_diagnostic.IDE0161.severity = warning # file-scoped namespace

# EF Core migrations are generated by dotnet-ef; analyzers and dotnet format skip them.
[backend/src/Musialize.Infrastructure/Persistence/Migrations/*.cs]
generated_code = true
