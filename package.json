{
  "name": "musialize",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,magenta --kill-others \"dotnet watch --project backend/src/Musialize.Api --non-interactive\" \"pnpm --filter @musialize/web dev\"",
    "test": "pnpm test:backend && pnpm test:web",
    "test:backend": "dotnet test --solution backend/Musialize.slnx",
    "test:web": "pnpm --filter @musialize/web test",
    "generate:api": "dotnet build backend/src/Musialize.Api && pnpm --filter @musialize/web generate:api-types",
    "lint": "pnpm lint:format && pnpm lint:eslint && pnpm lint:types && pnpm lint:dotnet && pnpm lint:links",
    "lint:format": "prettier --check .",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:types": "pnpm --filter @musialize/web typecheck",
    "lint:dotnet": "dotnet format backend/Musialize.slnx --verify-no-changes",
    "lint:links": "remark . --frail --quiet --no-stdout",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0",
    "typescript-eslint": "^8.72.2"
  }
}
